META_MODEL_API_KEY=your_meta_model_api_key_here
PORT=3000
NODE_ENV=development

# Optional — increases GitHub API rate limit from 60/hr to 5000/hr
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Google Analytics — create a data stream at analytics.google.com and paste the G- ID here
VITE_GA_ID=G-XXXXXXXXXX

# Encrypts users' own API keys in the browser. Generate with: npm run byok:keygen
# Required on Vercel; optional locally (a temporary key is used if unset).
BYOK_PRIVATE_KEY=
